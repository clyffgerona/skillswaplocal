<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SkillSwapLocal" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/navy_primary</item>
        <item name="colorPrimaryVariant">@color/navy_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/mint_accent</item>
        <item name="colorOnSecondary">@color/navy_primary</item>
        <item name="android:statusBarColor">@color/navy_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Badge styles -->
    <style name="BadgeSwap">
        <item name="android:background">@drawable/bg_badge_swap</item>
        <item name="android:textColor">@color/mint_dark</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <style name="BadgeCash">
        <item name="android:background">@drawable/bg_badge_cash</item>
        <item name="android:textColor">@color/amber_dark</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <style name="StatBox">
        <item name="android:background">@drawable/bg_stat_box</item>
        <item name="android:padding">8dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="AvailChip">
        <item name="android:background">@drawable/bg_avail_chip</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:minWidth">28dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="AvailChip.Active">
        <item name="android:background">@drawable/bg_avail_chip_active</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="BookButton">
        <item name="android:background">@drawable/bg_book_btn</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

</resources>
