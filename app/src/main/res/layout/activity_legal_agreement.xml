<?xml version="1.0" encoding="utf-8"?>
<!-- activity_legal_agreement.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_primary"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingBottom="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_legal_shield"
            android:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Legal Agreement"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please review and accept our legal documents"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:alpha="0.8"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/llDocumentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/white"
        android:elevation="8dp">

        <TextView
            android:id="@+id/tvAgreementStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accepted 0/3 documents. Please accept all to continue."
            android:textSize="13sp"
            android:textColor="@color/amber_dark"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btnAcceptAll"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Accept All &amp; Continue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_book_btn"
            android:enabled="false"
            android:alpha="0.5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="By accepting, you agree to comply with all our terms and conditions."
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="12dp" />
    </LinearLayout>

</LinearLayout>