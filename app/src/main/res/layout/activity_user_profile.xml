<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0F2645"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Profile"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textColor="#4DB6AC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0F2645"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvAvatarInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text=""
                        android:textColor="#4DB6AC"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:background="#E5E9ED" />

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:clipToOutline="true"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvChangePfp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Photo"
                    android:textColor="#4DB6AC"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvVerifiedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verified Account"
                    android:textColor="#4CAF50"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- NEW: User Performance Stats Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#FFFFFF"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_box"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:layout_marginEnd="8dp">
                    <TextView android:id="@+id/tvMyRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5.0" android:textColor="#333333" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Rating" android:textColor="#7A8B9A" android:textSize="9sp" android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_box"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:layout_marginEnd="8dp">
                    <TextView android:id="@+id/tvMySessions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#333333" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sessions" android:textColor="#7A8B9A" android:textSize="9sp" android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_box"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <TextView android:id="@+id/tvMyShowUp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textColor="#333333" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Show-up" android:textColor="#7A8B9A" android:textSize="9sp" android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textColor="#7A8B9A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#F4F6F9"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp"
                    android:enabled="false"
                    android:alpha="0.6"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name cannot be changed after registration."
                    android:textColor="#7A8B9A"
                    android:textSize="10sp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About Me (Bio)"
                    android:textColor="#7A8B9A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etBio"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="#F4F6F9"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:gravity="top"
                    android:textSize="13sp"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="City / Barangay"
                    android:textColor="#7A8B9A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etLocation"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#F4F6F9"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="14dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skills Offered (comma-separated)"
                    android:textColor="#7A8B9A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etSkillsOffered"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="e.g. Math Tutoring, Logo Design"
                    android:background="#F4F6F9"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skill Details / Description"
                    android:textColor="#7A8B9A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etSkillDescription"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:hint="Describe what is included in your service, your experience, what tools you use, etc."
                    android:background="#F4F6F9"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:gravity="top"
                    android:textSize="13sp"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Availability"
                    android:textColor="#7A8B9A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/chipMon" android:layout_width="0dp" android:layout_height="32dp"
                        android:layout_weight="1" android:gravity="center" android:text="Mon" android:textSize="10sp" android:textStyle="bold"
                        android:background="#E5E9ED" android:textColor="#7A8B9A" android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/chipTue" android:layout_width="0dp" android:layout_height="32dp"
                        android:layout_weight="1" android:gravity="center" android:text="Tue" android:textSize="10sp" android:textStyle="bold"
                        android:background="#E5E9ED" android:textColor="#7A8B9A" android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/chipWed" android:layout_width="0dp" android:layout_height="32dp"
                        android:layout_weight="1" android:gravity="center" android:text="Wed" android:textSize="10sp" android:textStyle="bold"
                        android:background="#E5E9ED" android:textColor="#7A8B9A" android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/chipThu" android:layout_width="0dp" android:layout_height="32dp"
                        android:layout_weight="1" android:gravity="center" android:text="Thu" android:textSize="10sp" android:textStyle="bold"
                        android:background="#E5E9ED" android:textColor="#7A8B9A" android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/chipFri" android:layout_width="0dp" android:layout_height="32dp"
                        android:layout_weight="1" android:gravity="center" android:text="Fri" android:textSize="10sp" android:textStyle="bold"
                        android:background="#E5E9ED" android:textColor="#7A8B9A" android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/chipSat" android:layout_width="0dp" android:layout_height="32dp"
                        android:layout_weight="1" android:gravity="center" android:text="Sat" android:textSize="10sp" android:textStyle="bold"
                        android:background="#E5E9ED" android:textColor="#7A8B9A" android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/chipSun" android:layout_width="0dp" android:layout_height="32dp"
                        android:layout_weight="1" android:gravity="center" android:text="Sun" android:textSize="10sp" android:textStyle="bold"
                        android:background="#E5E9ED" android:textColor="#7A8B9A" android:clickable="true" android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exchange Modes"
                    android:textColor="#7A8B9A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbSkillSwap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Skill Swap"
                        android:textColor="#0F2645"
                        android:textSize="12sp"
                        android:layout_marginEnd="24dp" />

                    <CheckBox
                        android:id="@+id/cbCash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cash Exchange"
                        android:textColor="#0F2645"
                        android:textSize="12sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etPriceRange"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="Cash price range (e.g. Php 100 - 300)"
                    android:background="#F4F6F9"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privacy Settings"
                    android:textColor="#7A8B9A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <CheckBox
                    android:id="@+id/cbDiscoverable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show my profile in Nearby Providers"
                    android:textColor="#0F2645"
                    android:textSize="12sp"
                    android:checked="true" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAppeal"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Submit Appeal"
                android:textColor="@color/white"
                android:backgroundTint="#E53935"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Log Out"
                android:textColor="@color/white"
                android:backgroundTint="#7A8B9A"
                android:layout_margin="16dp"/>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottom_navigation_bar"
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true" />

</LinearLayout>