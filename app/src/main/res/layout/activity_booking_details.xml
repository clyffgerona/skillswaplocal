<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#0F2645"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:elevation="4dp"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Booking Details"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerLayout"
        android:layout_above="@+id/actionLayout"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_booking_card"
                android:padding="24dp"
                android:elevation="2dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SERVICE"
                            android:textColor="#7A8B9A"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:id="@+id/tvService"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading..."
                            android:textColor="#0F2645"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="LOADING..."
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#7A8B9A"
                        android:background="#E2E8EF"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8EF"
                    android:layout_marginBottom="20dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PROVIDER" android:textColor="#7A8B9A" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" android:fontFamily="sans-serif-medium"/>
                <TextView android:id="@+id/tvProviderName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loading..." android:textColor="#0F2645" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:layout_marginBottom="20dp" android:layout_marginTop="2dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DATE &amp; TIME" android:textColor="#7A8B9A" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" android:fontFamily="sans-serif-medium"/>
                <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loading..." android:textColor="#0F2645" android:textSize="15sp" android:fontFamily="sans-serif" android:layout_marginBottom="20dp" android:layout_marginTop="2dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MEETING LOCATION" android:textColor="#7A8B9A" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" android:fontFamily="sans-serif-medium"/>
                <TextView android:id="@+id/tvLocation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loading..." android:textColor="#0F2645" android:textSize="15sp" android:fontFamily="sans-serif" android:layout_marginBottom="20dp" android:layout_marginTop="2dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EXCHANGE MODE" android:textColor="#7A8B9A" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" android:fontFamily="sans-serif-medium"/>
                <TextView android:id="@+id/tvExchange" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loading..." android:textColor="#4DB6AC" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:layout_marginBottom="20dp" android:layout_marginTop="2dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOTES" android:textColor="#7A8B9A" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" android:fontFamily="sans-serif-medium"/>
                <TextView android:id="@+id/tvNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loading..." android:textColor="#0F2645" android:textSize="15sp" android:fontFamily="sans-serif" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/proofLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_booking_card"
                android:padding="24dp"
                android:elevation="2dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvProofTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Proof of Work"
                    android:textColor="#0F2645"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvProofSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Please upload a photo of the completed service to prevent fake ratings."
                    android:textColor="#7A8B9A"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginBottom="20dp"
                    android:lineSpacingExtra="4dp"/>

                <ImageView
                    android:id="@+id/ivProofImage"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="#E2E8EF"
                    android:scaleType="centerCrop"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnUploadProof"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Attach Photo"
                    android:textColor="#0F2645"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:backgroundTint="#E2E8EF"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reviewDisplayLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_booking_card"
                android:padding="24dp"
                android:elevation="2dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your Rating"
                    android:textColor="#0F2645"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tvDisplayStar1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★" android:textSize="32sp" android:textColor="#E2E8EF" android:layout_marginEnd="6dp"/>
                    <TextView android:id="@+id/tvDisplayStar2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★" android:textSize="32sp" android:textColor="#E2E8EF" android:layout_marginEnd="6dp"/>
                    <TextView android:id="@+id/tvDisplayStar3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★" android:textSize="32sp" android:textColor="#E2E8EF" android:layout_marginEnd="6dp"/>
                    <TextView android:id="@+id/tvDisplayStar4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★" android:textSize="32sp" android:textColor="#E2E8EF" android:layout_marginEnd="6dp"/>
                    <TextView android:id="@+id/tvDisplayStar5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★" android:textSize="32sp" android:textColor="#E2E8EF" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cancellationLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_booking_card"
                android:padding="24dp"
                android:elevation="2dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cancellation Details"
                    android:textColor="#D32F2F"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvCancellationReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No reason provided."
                    android:textColor="#0F2645"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reportLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_booking_card"
                android:padding="24dp"
                android:elevation="2dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Need Help?"
                    android:textColor="#0F2645"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="If this cancellation was abusive or violated our rules, you can report it."
                    android:textColor="#7A8B9A"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginBottom="20dp"
                    android:lineSpacingExtra="4dp"/>

                <Button
                    android:id="@+id/btnReport"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Report User"
                    android:textColor="#D32F2F"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:backgroundTint="#FEEBEE"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/actionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:layout_alignParentBottom="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnCancelClient"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="Cancel Request"
            android:textColor="#D32F2F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_tag_chip"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/btnDeclineProvider"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Decline"
            android:textColor="#7A8B9A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_tag_chip"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/btnApproveProvider"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1.5"
            android:gravity="center"
            android:text="Approve Request"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_btn_accept"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/btnReject"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="#D32F2F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_tag_chip"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/btnComplete"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1.5"
            android:gravity="center"
            android:text="Mark Complete"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_btn_accept"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:alpha="0.5"/>
    </LinearLayout>

</RelativeLayout>